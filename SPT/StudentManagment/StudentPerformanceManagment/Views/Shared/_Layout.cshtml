@model StudentPerformanceManagment.Models.LayoutUserViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentPerformanceManagment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentPerformanceManagment.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- TOP NAVBAR -->
    <div style="text-align:right">
    @if (Model != null)
    {
        @await Html.PartialAsync("_TopNavbar", Model)
    }
    </div>

    <div class="d-flex">
        <!-- SIDEBAR -->
        @if (Model != null)
        {
            @await Html.PartialAsync("_LeftMenubar", Model)
        }


        <!-- MAIN CONTENT -->
        <main role="main" class="flex-grow-1 p-3">
            @RenderBody()
        </main>
        

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
