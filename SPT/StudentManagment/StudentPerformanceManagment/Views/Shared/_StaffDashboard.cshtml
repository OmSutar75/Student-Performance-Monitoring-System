@using StudentPerformanceManagment.Models.ViewModel
@model StaffDashViewModel

@{
    var today = DateTime.Now;

    // Advanced Priority Logic:
    // 1. Sirf Active tasks filter karein.
    // 2. Unhe sort karein Time-Elapsed ratio ke hisaab se (Jinka waqt khatam hone wala hai wo upar).
    var prioritizedTasks = Model.Tasks
        .Where(t => today >= t.ValidFrom && today <= t.ValidTo)
        .OrderByDescending(t =>
        {
            var totalDuration = (t.ValidTo - t.ValidFrom).TotalMinutes;
            var timePassed = (today - t.ValidFrom).TotalMinutes;
            return totalDuration > 0 ? (timePassed / totalDuration) : 0;
        })
        .Take(5)
        .ToList();
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-md-row align-items-center justify-content-between">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Staff Dashboard</h3>
                    <p class="text-muted mb-0">Welcome back! You have <span class="text-primary fw-bold">@prioritizedTasks.Count</span> urgent tasks to attend.</p>
                </div>
                <div class="text-md-end mt-3 mt-md-0">
                    <div class="badge bg-primary-subtle text-primary p-2 px-3 rounded-pill">
                        <i class="bi bi-calendar3 me-2"></i> @today.ToString("dd MMMM, yyyy")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content: Priority Tasks Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-fire me-2 text-danger"></i>High Priority Tasks
            </h5>
            <a href="/Staff/MyTasks" class="btn btn-sm btn-link text-decoration-none fw-bold">View All Tasks</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Subject Details</th>
                        <th>Batch/Group</th>
                        <th style="width: 300px;">Timeline & Progress</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!prioritizedTasks.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-all fs-1 d-block mb-2 text-success"></i>
                                All caught up! No active tasks found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var task in prioritizedTasks)
                        {
                            // Days calculation
                            var totalDays = (task.ValidTo - task.ValidFrom).TotalDays;
                            var daysLeft = Math.Max(0, (task.ValidTo - today).TotalDays);

                            // Calculate percentage of time passed
                            var percentPassed = totalDays > 0 ? ((today - task.ValidFrom).TotalDays / totalDays) * 100 : 0;
                            percentPassed = Math.Min(100, Math.Max(0, percentPassed));

                            // Priority Color Logic
                            string statusColor = daysLeft <= 2 ? "danger" : (daysLeft <= 5 ? "warning" : "primary");
                            string priorityLabel = daysLeft <= 2 ? "High Priority" : (daysLeft <= 5 ? "Medium" : "Normal");

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@task.Subject.SubjectName</div>
                                    <div class="small text-muted">@task.Course.CourseName</div>
                                    <span class="badge bg-@statusColor-subtle text-@statusColor border border-@statusColor-subtle mt-1" style="font-size: 0.65rem;">
                                        @priorityLabel
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3">
                                        <i class="bi bi-people me-1"></i> @task.CourseGroup.GroupName
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted">Start: @task.ValidFrom.ToString("dd MMM")</span>
                                        <span class="fw-bold text-@statusColor">Due: @task.ValidTo.ToString("dd MMM")</span>
                                    </div>
                                    <div class="progress mb-1" style="height: 6px;">
                                        <div class="progress-bar bg-@statusColor shadow-sm"
                                             role="progressbar"
                                             style="width: @percentPassed%"></div>
                                    </div>
                                    <div class="d-flex justify-content-between" style="font-size: 0.7rem;">
                                        <span class="text-muted small">Started @Math.Round((today - task.ValidFrom).TotalDays) days ago</span>
                                        <span class="fw-bold">@Math.Ceiling(daysLeft) days left</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a href="/Staff/AddMark/@task.TasksId" class="btn btn-sm btn-@statusColor rounded-pill px-3 shadow-sm hover-up">
                                        <i class="bi bi-plus-circle me-1"></i> Add Marks
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rounded-4 {
        border-radius: 1rem !important;
    }

    .bg-primary-subtle {
        background-color: #cfe2ff !important;
    }

    .bg-danger-subtle {
        background-color: #f8d7da !important;
    }

    .bg-warning-subtle {
        background-color: #fff3cd !important;
    }

    .hover-up:hover {
        transform: translateY(-2px);
        transition: all 0.2s;
    }

    .table-hover tbody tr:hover {
        background-color: #fcfdfe;
    }
</style>
