


<div class="content">

    <h4 class="fw-bold">STAFF DASHBOARD</h4>
    <p>Welcome, !</p>

    <!-- STAT CARDS -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon">📋</div>
                <div>
                    <small>Total Tasks</small>
                    <h5 class="fw-bold">@Model.TaskCount</h5>
                </div>
            </div>
        </div>



        <!-- PENDING TASKS -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold">PENDING TASKS</h6>
            <a href="#">View All ▶</a>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                @foreach (var t in Model.Tasks)
                {
                    <div class="task-card">
                        <h6 class="fw-bold">@t.TasksDescription</h6>
                        <p class="mb-1">Batch: MCA-2024-A | Subject: DBMS (@t.SubjectId)</p>
                        <p class="mb-1">Deadline: @t.ValidTo</p>
                        <p>Status: @t.Status</p>
                        <button class="btn btn-outline-dark btn-sm">＋ ADD MARKS</button>
                    </div>
                }
            </div>

            <div class="col-md-6">
                <div class="task-card">
                    <h6 class="fw-bold">Data Structures Evaluation</h6>
                    <p class="mb-1">Batch: MCA-2024-B | Subject: DS</p>
                    <p class="mb-1">Deadline:</p>
                    <p>Status:</p>
                    <button class="btn btn-outline-dark btn-sm">＋ ADD MARKS</button>
                </div>
            </div>
        </div>

        <!-- OVERDUE TASKS -->
        <h6 class="fw-bold">OVERDUE TASKS ⚠</h6>

        <div class="overdue d-flex justify-content-between align-items-center">
            <strong>Python Lab Marks</strong>
            <div>
                <span class="me-3">Deadline Passed</span>
                <button class="btn btn-outline-dark btn-sm">Request Extension</button>
            </div>
        </div>

    </div>

    <style>
        body {
            background-color: #f7f7f7;
            font-family: "Segoe UI", sans-serif;
        }

        /* MAIN CONTENT */
        .content {
            margin-left: 10px;
            padding: 20px;
        }

        .stat-card {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 15px;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            border: 1px solid #000;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .task-card {
            border: 1px solid #000;
            border-radius: 12px;
            padding: 15px;
            background: #fff;
        }

        .overdue {
            background: #f8c9c9;
            border: 1px solid #cc0000;
            padding: 15px;
            border-radius: 10px;
        }
    </style>
