@model StudentPerformanceManagment.Models.ViewModel.AddCourseGroupMV;

@{
    ViewData["Title"] = "Add Course Group";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-semibold text-primary">
            <i class="bi bi-journal-plus"></i> Add Course Group
        </h4>
        <a asp-action="CourseGroups" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <form asp-action="AddCourseGroup" method="post">

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Course</label>
                            <select asp-for="CourseId" asp-items="Model.Courses" class="form-select">
                                <option value="">-- Select Course --</option>
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-7">
                                <label class="form-label fw-semibold">Group Prefix</label>
                                <input name="GroupPrefix" class="form-control text-uppercase"
                                       placeholder="e.g. D" maxlength="1" required
                                       style="text-transform: uppercase;" />
                                <small class="text-muted">Single letter According Course</small>
                            </div>

                            <div class="col-5">
                                <label class="form-label fw-semibold">Count</label>
                                <input name="GroupCount" type="number" class="form-control"
                                       min="1" max="6" value="1" required />
                                <small class="text-muted">Max 6</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end border-top pt-3">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-magic"></i> Generate Groups
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>