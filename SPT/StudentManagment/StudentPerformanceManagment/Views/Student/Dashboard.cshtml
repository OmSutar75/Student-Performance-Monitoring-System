@using StudentPerformanceManagment.Models.ViewModel
@model StudentViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="student-dashboard">

    <!-- DASHBOARD HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">Student Dashboard</h3>
            <p>Welcome, @User.Identity.Name</p>
        </div>
    </div>

    <!-- PROFILE CARD -->
    <div class="card shadow-sm mb-4 task-card">
        <div class="card-body">
            <div class="row align-items-center">

                <div class="col-md-3 text-center">
                    <img src="https://via.placeholder.com/120"
                         class="rounded-circle border mb-3"
                         alt="Profile Photo">
                </div>

                <div class="col-md-9">
                    <h5 class="mb-2">@Model.Name</h5>
                    <p class="mb-1"><strong>PRN:</strong>@Model.PRN</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                    <p class="mb-1"><strong>Mobile:</strong>@Model.MobileNo</p>
                    <p class="mb-3"><strong>Course:</strong> @Model.CourseName</p>

                    <a href="/Student/EditProfile" class="btn btn-primary btn-sm">
                        Edit Profile
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- STATS CARDS -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card text-center">
                <div class="stat-icon">📚</div>
                <div>
                    <small>Subjects</small>
                    <h5 class="fw-bold">@Model.SubjectCount</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card text-center">
                <div class="stat-icon">🏆</div>
                <div>
                    <small>Group Name</small>
                    <h5 class="fw-bold">@Model.CourseGroupName</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card text-center">
                <div class="stat-icon">📈</div>
                <div>
                    <small>Overall %</small>
                    <h5 class="fw-bold">78%</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- PERFORMANCE CARD -->
    <a href="/Student/Performance" class="text-decoration-none">
        <div class="card shadow-sm student-hover-card text-center task-card">
            <div class="card-body" >

                <h5>Performance</h5>
                <p class="text-muted mb-3">View detailed academic performance</p>
                <a href="/Student/StudentPerformance">
                    <span class="btn btn-outline-primary btn-sm ">
                            View Performance
                    </span>
                </a>
            </div>
        </div>
    </a>

</div>

<style>
    body {
        background-color: #f7f7f7;
        font-family: "Segoe UI", sans-serif;
    }

    .student-dashboard {
        margin-left: 10px;
        padding: 20px;
    }

    /* STAT CARDS */
    .stat-card {
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 15px;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        gap: 15px;
        justify-content: center;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border: 1px solid #000;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* TASK CARD (Profile & Performance) */
    .task-card {
        border: 1px solid #000;
        border-radius: 12px;
        padding: 15px;
        background: #fff;
    }

    /* HOVER EFFECT */
    .student-hover-card:hover {
        transform: translateY(-4px);
        transition: 0.3s ease;
        box-shadow: 0 6px 18px rgba(0,0,0,0.15);
    }
</style>
