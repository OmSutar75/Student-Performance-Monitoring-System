
@model IEnumerable<StudentPerformanceManagment.Models.Tasks>
<h2>Staff Dashboard</h2>

<p>Welcome Staff</p>

<a href="/Staff/ViewTask"></a>

<h1>My Tasks</h1>

<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Subject</th>
            <th>Group</th>
            <th>Valid From</th>
            <th>Valid To</th>
            <th>Status</th>
            <th colspan="2">Opertaion</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course.CourseName</td>
                <td>@item.Subject.SubjectName</td>
                <td>@item.CourseGroup.GroupName</td>
                <td>@item.ValidFrom.ToShortDateString()</td>
                <td>@item.ValidTo.ToShortDateString()</td>
                <td>
                    @if (item.IsActive(DateTime.Now))
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Expired/Pending</span>
                    }
                </td>
                <td><a href="#">Add Marks</a></td>
                <td><a href="#">Request</a></td>
            </tr>
        }
    </tbody>
</table>



<a href="/Account/Logout">Logout</a>
