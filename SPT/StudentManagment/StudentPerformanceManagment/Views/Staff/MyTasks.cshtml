@using StudentPerformanceManagment.Models.ViewModel
@model StaffDashViewModel

@{
    ViewData["Title"] = "My Active Tasks";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Active Tasks</h2>
            <p class="text-muted small">Showing only currently active assignments for @DateTime.Now.Year</p>
        </div>
    </div>

    <!-- Tasks Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Course & Subject</th>
                        <th>Group</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Tasks)
                    {
                        @* --- Filter: Sirf Active tasks dikhane ke liye --- *@
                        if (item.IsActive(DateTime.Now))
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-primary">@item.Course.CourseName</div>
                                    <div class="small text-muted">@item.Subject.SubjectName</div>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3">
                                        @item.CourseGroup.GroupName
                                    </span>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">To: @item.ValidTo.ToShortDateString()</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">From: @item.ValidFrom.ToShortDateString()</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group gap-2">
                                        <a href="/Staff/AddMark/@item.TasksId" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                            <i class="bi bi-plus-lg"></i> Add Marks
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="bi bi-envelope"></i> Request
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    @* --- Agar koi bhi active task na ho toh message dikhaye --- *@
                    @if (!Model.Tasks.Any(t => t.IsActive(DateTime.Now)))
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                No active tasks found for today.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
