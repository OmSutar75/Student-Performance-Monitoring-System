@using StudentPerformanceManagment.Models.ViewModel
@model StaffDashViewModel

@{
    ViewData["Title"] = "My Tasks";
}


<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f7f7f7;
            font-family: "Segoe UI", sans-serif;
        }

        .sidebar {
            width: 220px;
            min-height: 100vh;
            background: #e9e9e9;
            padding: 15px;
            position: fixed;
        }

        .menu-item {
            padding: 10px 12px;
            border-radius: 6px;
            margin-bottom: 8px;
            background: #fff;
            border: 1px solid #ccc;
            cursor: pointer;
        }

            .menu-item.active {
                background: #dcdcdc;
                font-weight: 600;
            }

        .topbar {
            height: 55px;
            background: #d9d9d9;
            padding: 10px 20px;
            margin-left: 220px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: right;
        }

        .content {
            margin-left: 220px;
            padding: 20px;
        }
    </style>
</head>
<body>

    <div class="content">
        <h1>My Tasks (@Model.TaskCount)</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Subject</th>
                    <th>Group</th>
                    <th>Valid From</th>
                    <th>Valid To</th>
                    <th>Status</th>
                    <th colspan="2">Operation</th>
                </tr>
            </thead>
            <tbody>
                @* Notice we now loop through Model.Tasks *@
                @foreach (var item in Model.Tasks)
                {
                    <tr>
                        <td>@item.Course.CourseName</td>
                        <td>@item.Subject.SubjectName</td>
                        <td>@item.CourseGroup.GroupName</td>
                        <td>@item.ValidFrom.ToShortDateString()</td>
                        <td>@item.ValidTo.ToShortDateString()</td>
                        <td>
                            @if (item.IsActive(DateTime.Now))
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Expired/Pending</span>
                            }
                        </td>
                        <td><a href="/Staff/AddMark">Add Marks</a></td>
                        <td><a href="#">Request</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>


