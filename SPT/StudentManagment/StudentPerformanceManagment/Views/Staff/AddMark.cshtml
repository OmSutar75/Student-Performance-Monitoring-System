@model StudentPerformanceManagment.Models.ViewModel.MarkViewModel

@{
    ViewData["Title"] = "AddMark";
}

<h1>AddMark</h1>

<h4>MarkViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddMark">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <table>
                <thead>
                <th>StudentPRN</th>
                <th>Name</th>
                    <th>TheoryMarks</th>
                <th>LabMarks</th>
                <th>InternalMarks</th>
                
                </thead>

                <tbody>
                    @foreach(var item in Model.students)
                    {
                        <tr>
                           <td> @item.PRN</td>
                            <td> @item.Name</td>
                            <td><input asp-for="TheoryMarks" class="form-control" /></td>
                            <td><input asp-for="LabMarks" class="form-control" /></td>
                            <td><input asp-for="InternalMarks" class="form-control" /></td>
                            <td><input asp-for="Total" class="form-control" /></td>
                            <td><button type="submit" value="update" class="btn btn-primary" />Update</td>



                        </tr>
                    }
                </tbody>
            </table>
            
            
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
