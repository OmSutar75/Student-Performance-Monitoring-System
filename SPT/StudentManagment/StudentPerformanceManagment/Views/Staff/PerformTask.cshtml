@model List<StudentPerformanceManagment.Models.ViewModel.MarkViewModel>

<table class="table">
    <thead>
        <tr>
            <th>PRN</th>
            <th>Name</th>
            <th>Theory</th>
            <th>Lab</th>
            <th>Internal</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <form asp-action="SaveMark" method="post">
                    @Html.AntiForgeryToken()

                <td>@item.PRN</td>
                <td>@item.Name</td>

                <input type="hidden" name="StudentId" value="@item.StudentId" />
                <input type="hidden" name="SubjectId" value="@item.SubjectId" />


                <td>
                    <button type="submit" class="btn btn-primary">Save Mark</button>
                </td>

                </form>
            </tr>
        }
    </tbody>
</table>